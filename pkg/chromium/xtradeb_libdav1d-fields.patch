@@ -143,12 +143,14 @@ impl Dav1d {
         unsafe { dav1d_default_settings(settings_uninit.as_mut_ptr()) };
         // # Safety: settings_uninit was initialized in the C function above.
         let mut settings = unsafe { settings_uninit.assume_init() };
