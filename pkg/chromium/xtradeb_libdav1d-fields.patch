--- a/third_party/webrtc/modules/video_coding/codecs/av1/dav1d_decoder.cc
+++ b/third_party/webrtc/modules/video_coding/codecs/av1/dav1d_decoder.cc
@@ -98,8 +98,10 @@ bool Dav1dDecoder::Configure(const Setti
   Dav1dSettings s;
   dav1d_default_settings(&s);
 
+#if 0	// XtraDeb fix
   s.n_threads = std::clamp(settings.number_of_cores(), 1, DAV1D_MAX_THREADS);
   s.max_frame_delay = 1;  // For low latency decoding.
+#endif
   s.all_layers = 0;       // Don't output a frame for every spatial layer.
