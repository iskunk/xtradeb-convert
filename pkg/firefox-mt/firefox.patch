A subset/adaptation of the modifications posted to

  https://code.launchpad.net/~skunk/firefox/+git/firefox/+merge/500524

--- a/debian/build/rules.mk
+++ b/debian/build/rules.mk
@@ -57,7 +57,7 @@ DEB_DH_STRIP_ARGS		:= --dbg-package=$(MOZ_PKG_NAME)-dbg
 # We don't want build-tree/mozilla/README to be shipped as a doc
 DEB_INSTALL_DOCS_ALL 	:= $(NULL)
 # Stop the buildd from timing out during long links
-MAKE			:= python3 $(CURDIR)/debian/build/keepalive-wrapper.py 1440 $(MAKE)
+MAKE			:= python3 $(CURDIR)/debian/build/keepalive-wrapper.py 6000 $(MAKE)
 
 MOZ_VERSION		:= $(shell cat $(DEB_SRCDIR)/$(MOZ_APP)/config/version.txt)
 MOZ_LIBDIR		:= usr/lib/$(MOZ_APP_NAME)
--- a/debian/config/mozconfig.in
+++ b/debian/config/mozconfig.in
@@ -84,7 +84,7 @@ ac_add_options --enable-rust-simd
 %%endif
 %%endif
 ac_add_options --enable-linker=lld-@DEB_LLVM_VERSION@
-%%if DEB_HOST_ARCH != armhf
+%%if DEB_BUILD_ARCH != armhf
 %%if DEB_HOST_ARCH != riscv64
 # armhf: Causes OOM failures
 # riscv64: Causes "relocation R_RISCV_JAL out of range" link errors
--- a/debian/control.in
+++ b/debian/control.in
@@ -4,6 +4,7 @@ Section: web
 Priority: optional
 Maintainer: Ubuntu Mozilla Team <ubuntu-mozillateam@lists.ubuntu.com>
 Vcs-Bzr: https://code.launchpad.net/~mozillateam/firefox/firefox.noble
+Rules-Requires-Root: no
 Build-Depends: cdbs,
 	locales,
 	debhelper (>= 10),
