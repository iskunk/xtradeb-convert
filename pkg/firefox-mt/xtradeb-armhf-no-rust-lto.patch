--- a/python/mozbuild/mozbuild/rust_commands.py
+++ b/python/mozbuild/mozbuild/rust_commands.py
@@ -417,6 +417,11 @@ def applies_library_lto(kind, lto, subst
 
     Release builds enable link time optimization unless the library opted out.
     """
+    import os
+    # XtraDeb: Don't use LTO for gkrust on armhf
+    if "--target=armv7-unknown-linux-gnueabihf" in _cargo_config(substs).get("MOZ_CARGO_HOST_TARGET_ARGS"):
+        if os.getcwd().endswith("/toolkit/library/rust"):
+            lto = False
     return bool(
         kind == "library" and _cargo_config(substs).get("RUST_LTO_ELIGIBLE") and lto
     )
