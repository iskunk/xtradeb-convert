Work around errors like

  E error[E0658]: the target feature `avx512f` is currently unstable

when building with rustc 1.88. Also requires setting RUSTC_BOOTSTRAP=1 in
the environment.

--- a/Cargo.lock
+++ b/Cargo.lock
@@ -8885,7 +8885,6 @@ dependencies = [
 name = "zlib-rs"
 version = "0.6.3"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "3be3d40e40a133f9c916ee3f9f4fa2d9d63435b5fbe1bfc6d9dae0aa0ada1513"
 
 [[package]]
 name = "zmij"
--- a/third_party/rust/zlib-rs/src/adler32/avx512.rs
+++ b/third_party/rust/zlib-rs/src/adler32/avx512.rs
@@ -1,3 +1,7 @@
+#![feature(stdarch_x86_avx512)]
+#![feature(avx512bw)]
+#![feature(avx512f)]
+
 use core::arch::x86_64::{
     __m512i, _mm256_add_epi32, _mm256_castsi256_si128, _mm256_extracti128_si256, _mm512_add_epi32,
     _mm512_castsi512_si256, _mm512_extracti64x4_epi64, _mm512_madd_epi16, _mm512_maddubs_epi16,
