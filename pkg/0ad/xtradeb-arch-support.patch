diff --git a/source/maths/MD5.cpp b/source/maths/MD5.cpp
index 0ec7cbd9..e89b6610 100644
--- a/source/maths/MD5.cpp
+++ b/source/maths/MD5.cpp
@@ -56,7 +56,13 @@ void MD5::UpdateRest(const u8* data, size_t len)
 	// Process whole chunks of the input
 	while (len >= CHUNK_SIZE)
 	{
+#if defined(__ARM_ARCH_7A__)
+		// Avoid SIGBUS on alignment-sensitive architectures
+		memcpy(m_Buf, data, CHUNK_SIZE);
+		Transform((const u32*)m_Buf);
+#else
 		Transform((const u32*)data); // assumes little-endian; ignores alignment
+#endif
 		data += CHUNK_SIZE;
 		len -= CHUNK_SIZE;
 	}
